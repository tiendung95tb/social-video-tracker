#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

BUN_BIN=""
for candidate in \
  "$(command -v bun 2>/dev/null || true)" \
  "${HOME}/.bun/bin/bun" \
  "/opt/homebrew/bin/bun" \
  "/usr/local/bin/bun"; do
  if [[ -n "${candidate}" && -x "${candidate}" ]]; then
    BUN_BIN="${candidate}"
    break
  fi
done

if [[ -z "${BUN_BIN}" ]]; then
  echo "Error: Bun runtime not found. Install Bun: https://bun.sh" >&2
  exit 1
fi

if [[ -f "${PLUGIN_ROOT}/server/dist/index.js" ]]; then
  exec "${BUN_BIN}" run "${PLUGIN_ROOT}/server/dist/index.js" "$@"
else
  exec "${BUN_BIN}" run "${PLUGIN_ROOT}/server/src/index.ts" "$@"
fi
